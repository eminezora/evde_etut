# Copy to .env for local development. Never commit real values.

# --- Database -------------------------------------------------------------------------------
# Local development (SQLite, relative to prisma/dev-sqlite/):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL). On Vercel use the POOLED connection string; with PgBouncer/Supabase
# pooler add ?pgbouncer=true&connection_limit=1. Run migrations with the DIRECT (non-pooled) URL.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- Auth -----------------------------------------------------------------------------------
# Secret for signing session cookies, at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Invite code teachers must enter to register. Leave empty to disable teacher sign-up.
TEACHER_SIGNUP_CODE=""

# Public base URL of the site, used in e-mail links and as the Google OAuth redirect base
# (e.g. https://evde-etut.vercel.app). Falls back to the request origin when empty.
APP_URL=""

# --- E-mail (password reset) ------------------------------------------------------------------
# Resend (https://resend.com). MAIL_FROM must use a domain verified in Resend,
# e.g. "Evde Etüt <bildirim@alanadiniz.com>". Without these, reset e-mails are not sent.
MAIL_PROVIDER="resend"
RESEND_API_KEY=""
MAIL_FROM=""

# --- Google sign-in (optional; the button only appears when both are set) --------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI preparation content (optional; leave AI_PROVIDER empty to disable) -----------------
# AI_PROVIDER: "evren" (EVREN LLM, OpenAI-compatible), "anthropic" (Claude API), or empty.
# "mock" is for local development only and is ignored in production.
AI_PROVIDER="evren"
# Optional request timeout in ms (default 90000; keep it below the route's maxDuration of 180 s).
# EVREN answers took 41–60 s in tests but occasionally 120–150 s; 160000 avoids needless timeouts.
AI_TIMEOUT_MS=""

# EVREN LLM – compare models by changing only EVREN_LLM_MODEL (e.g. glm-5.3, gemma-4-31b, qwen3.8-flash-next)
EVREN_LLM_BASE_URL="https://evren-llmapi.ssyz.org.tr/v1"
EVREN_LLM_MODEL="glm-5.3"
EVREN_LLM_API_KEY=""
# Optional: none | low | medium | high | off (default low – glm-5.3 otherwise "thinks" for minutes)
EVREN_LLM_REASONING_EFFORT=""

# Anthropic (only when AI_PROVIDER=anthropic)
AI_API_KEY=""
# Optional. Default for anthropic: claude-opus-5-5
AI_MODEL=""

# --- Demo accounts (local presentations only; NOT needed on Vercel) ------------------------
# Password for all accounts created by `npm run demo` (min. 12 characters).
DEMO_PASSWORD=""
